 "poems": [
  {
   "seq": "1",
   "text": "はれかたきみの思ひ社悲しけれかすめる月も秋やまつらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "明かたのあまの戶わたる月影にうき人さへや衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "燒すてしあとゝもみえぬ夏草に今はたもえて行螢かな",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "秋草のかれはか下のきり〓〓すいつまてあかて人にきかれむ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "たなはたの戀や積りて天の川まれなる中の淵と成らん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "まつ陰の入海かけてしらすけの湊ふきこす秋のしほかせ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "遠さかる海士の小舟も哀なりゆらの湊の秋のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "秋の雨に桐のはおつる夕くれは思ひすつるそ待にまされる",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "みをすつる人やみるらん唐國のとら伏野への秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "山もとの末野の里のあけほのにまた人わけぬ雪をみるかな",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "日影さすかれ野の眞葛霜とけて過にし秋にかへる露哉",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山人は出たる跡の秋の庵殘れる鶴や夜半になくらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "何とかく色かはるらんきにもあらす草にもあらぬ人の〓とのは",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "心なきいは木にをける露まても秋とはいかて思ひいるらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "逢事はいつにならへる心とてひとりぬるよの悲しかるらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "また宵のは山のほくしもえそめて鹿まつとたにいかてしらせん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "いとひても後をいかにと思ふこそ猶よにとまる心なりけれ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "世やはうき人やはつらき大方のみを思はぬは心なりけり",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "この里はすみた河原も程遠しいかなる鳥に都とはまし",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "渡りする人も哀やまさるらんすみた河原のはるのあけほの",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "分ゆけはそこともみえす朝ほらけ遠きそ春の霞成ける",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "みよしのゝ山のはかすむ春〓とにみは新玉の年そふり行",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "いせのあまのたまものすそやまかふらん霞に遠き興つしら浪",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "年ことに後の春ともしらさりし花はいくたひ馴てみつらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "村雨に秋の露かる玉篠のみしかき夜はゝ曉もなし",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "さしも草さしもひまなき五月雨に伊吹の嶽のいかにもゆらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "吹かよふ音たにかはれ山城のときはの森の秋のはつかせ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "夕されは露吹おとす秋かせに末葉かたよる小野のしの原",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "置露も哀はかけよ春日野に殘る古枝の秋萩の花",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "いせ島や鹽のひかたのみわたりにいそかすやとる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "湊川秋行水の色そこき殘る山なく時雨ふるらし",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "もみち葉を染てしくるゝ秋山におくてのをしねほしや侘らん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "庵さす稻葉の雲も打なひき山田の原は時雨てそゆく",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "うかりける誰あふ事のならひより夕附鳥のねにわかるらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "しりなからいとはぬよ社悲しけれ我ためつらきみと思ふとて",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "深き夜に人しらしとてしほりつゝ袖の泪を月にみえぬる",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "秋つはのすかたの國に跡たるゝ神のまもりは我君のため",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "いかにせむ曇る淚のます鏡うらみしよりそ影はたえにし",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "ふりぬとて何歎くらん君か代に老といふ物そみはさかへける",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "忍ひかね涙の玉の〓を絕てこひのみたれそ袖にみえゆく",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "天河あさ瀨ふむまに七夕の待つる夜はも更やしぬらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "まくす原うら葉も白く亂れつゝ風のまゝなる秋の夕露",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "霜枯の野もせの草は我〓やみにふりはてゝしほれ侘らん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "きえ殘るためしも戀し春日山春のひかりにもるゝ白露",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "いかてかは唐土舟のほのかにも我こふらくをしらせそめまし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "小男鹿も木のまの月の影みてや心つくしの妻をこふらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "梓弓はるかにとはぬ日數をも心つよくやうらみはてまし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "岩におふるためしを何に賴けむつゐにつれなき松の色哉",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "み〓とのりうけてつたへし我心くもらぬ程は神そしるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "蓮葉の露のうきよとしりなからにこりにしむは心なりけり",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "〓かれの翅にかくる芦原の露はまよはぬしほりなるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "あすしらぬ我みなからも櫻花うつろふ色そけふは悲しき",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "かく計なこりおしくはみにそふる秋ともさらに何歎らん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "我ためになく虫のねにあらねともね覺なれはや悲しかるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "待人はむなしきくれに何と又あしたゆくゝるさゝがにの糸",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "しらま弓いるきの山の夕霧に立かくれてや鹿ばなくらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "おなしくは浦にかきをけもしほ草はては煙も立ははなれし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "みのうさを歎にあまる淚こそ忍ふにたへぬ色はみえけれ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "いつまてか夜寒の衣ぬきかけて哀と民を思ひしりけむ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "年をへてつらき心の限をもみはてゝよはる玉のをもかな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "たちかふるけふは卯月の始めとや神のみ室に榊とるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "いく秋かかはらぬ影の月に又萬代かけて猶契るかな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "よしさらは越路を旅といひなさむ秋は都にかへる雁かね",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "秋の夜は須磨の關守もりかへて月やゆきゝの人とゝむらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "すくもたく藻汐の煙なひけたゝ恨し末のしるへともみむ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "よそにのみみつの濵松年をへてつれなき色にかへる浪哉",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "はかなくも思ひなくさむ心かなおなし世にふる賴みはかりに",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "をのつから日影もしらぬ谷河の岩まの氷いくへともなし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "千年ふるためしは今そしら雪のかされて積る庭の松かえ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "おきつかヾ吹上の濵の白妙に猶すみのほる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "いかにせん散にし花のおもかけか忘れんとすれは嶺の白雲",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "ときわかすいつも夕はあるものを秋しもなとか悲しかるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "うたかひし命のうちに疾にけり哀なりけるやとの花かな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "しはしたに猶立かへれまくす原うら枯てゆく秋のわかれち",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "つらかりし時こそあらめあひみての後さへ物はなそや悲しき",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "松島やあまのもしほ木それならてこりぬ思ひに立煙かな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "人を社つらしと思ふに涙さへなとうきたひにみを離るらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "いかなりし秋に涙の露そめてみはならはしと袖のぬるらむ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "定めなくさても世にふる此頃の時雨のやとや我み成らん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "大空に吹くる風の匂ふかな雲のうへにもはなやさくらむ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "昔しより移ふからに恨むるをくるしきよとや花の散らん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "よの常のみより外なる秋ならはなへての露に袖はめらさし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "したもえやくるしかるらん鳴聲もきこえぬ虫のよはの思ひは",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "されはとていとひもはてぬよの中をうきたひ每に何歎くらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "僞のまたれし事も今はなしそれたにいつと賴みをかねは",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "哀なり草のかけにもしら露のかゝるへしとは思はさりしを",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "秋かせは雲の塵をや拂ふらん空のかゝみの夜はの月かけ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "何とてか詞にふたつわかるらんよきもあしきもひとつ心を",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "あかしかた浪の音にやかよふらん浦より遠の岡の松かせ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "天地のほかなる山にのかれねはかくても花に物やおもはむ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "富士のねは咲ける花の習までけに時しらぬやまさくら哉",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "天河もみちのはしや秋をへて渡れとたえぬにしき成らん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "うきをしる淚のとかといひなして袖よりかすむ春のよの月",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "物おもはていつれの年の秋まてか露に袂のしらねさりけん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "秋きてもいはねの床のつれなきに涙色つく苔の袖かな",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "荻か葉にありける物を花ゆへに春もうかりし風のやとりは",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "いかにして涙は袖にとまるらん通ふ心はひまもなきみに",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "ともの浦のいそおにたてる室の木につなける舟の主は誰そも",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "なからへはしはしも月をみるへきに山のは近きみ社つらけれ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "春雨のあまねき御代のめくみとは賴む物からぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "山のはのつらさ計やのこるらん空より外にあくる月かけ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "はれ曇る影を都にさきたてゝ時雨るとつくる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "物ことに忘れかたみをとゝめをきて涙のたゆむ時のまそなき",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "中〓ヽにまた賴まるゝ世なりけり變るへしとは契りやはせし",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "今は又みさへ朽木の柚山に何〓との葉をかきあつめまし",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "いまは又ららてもまかふ時雨哉獨ふり行庭のまつかせ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "今さらに海士のいさり火たくなはの苦しき程を知る人そなき",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "ほの〓〓とあけのそほ舟こき歸り煙しらめる海士のもしほ火",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "しめゆひしまかきやたはに成ぬらん花をもけなる庭の山吹",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "散るをうしと思ひし花そまたれける春くることに物忘して",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "あし曳の山下風のいつのまに音吹かへて秋はきぬらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "天河おなしかたのゝ女郞花秋と契りて誰をまつらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "獨ねはなかきならひの秋の夜をあかしかねてや鹿も鳴らん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "山里にいつしか人のまたるゝやすみはつまじき心なるらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "夕しほや遠つひかたにみちぬらん鳴てちかつく友千鳥かな",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "いとへとて思ひしらする世中をうきたひ每に何うらむらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "白妙の我衣手をかたしきて獨やねなんいもにこひつゝ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "みしよこそ思ひいてゝも忍はるれしらぬ昔のなとや戀しき",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "かく計くるゝ別をしたふとも思ひもしらて春やゆくらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "をのかすむ越路の花はまた咲かしいそかてかへれ春の鴈かね",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "またれつる時は五月に成にけり小田の早苗もいまいそくらし",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "五月雨のふりわけかみはかた過て井筒にあまる水のしら浪",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "としなみもさこそこゆらめ降雪の積る日數の末のまつ山",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "長月の菊のしら露淵とならはまかきの島は外にもとめし",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "おもひ侘うきおもかけやなくさむとみれは悲しき有明の月",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "春日野の野もりの鏡これやこのよそに三笠の山のはの月",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "かはらやの下にこかるゝ夕煙たえぬ思ひのありとたにみよ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "浦人のあし火たくやのすゝけたるみには難波の〓とも物うし",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "霞めともまよはてかへる鴈かねはよその越路や穴エにしるらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "一枝は折てかへらん山櫻家つとなからみぬ人のため",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "櫻花匂ふやいつこみよしのゝきさ山きはに霞立らし",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "春霞かすむとみれは山のはの雲まも曇る夜はの月影",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "またみねは面影もなしなにしかもまのゝかや原露みたるらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "しのひねと誰いひそめて郭公きくへき頃を又過すらむ",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "み〓とのり道にそむかぬゆへとてや海の外にも守りあるらん",
   "kana": "",
   "speaker": "",
   "page": 521,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "吹からに雲もかゝらし紅葉する嵐の山はいつしらるらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "いかならん時かあらはにしらるへき國に報ゆる心ありとも",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "黑髪をてならすたひにいとふ哉哀いつかと思ひみたれて",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "をとめこかかさしの櫻咲にけり袖ふる山にかゝるしら雲",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "きてみよと何かは人につけやらん我宿にのみ月はすましを",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "今よりの衣かりかね秋かせに誰夜寒とかなきてきぬらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "時わかぬこしのしら根の雪をみて秋とはいかて膓のきぬらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "よそにきく我ねさめたになかき夜をあかすや賤か衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "あすかには衣うつなりたをやめか袖の秋かせ夜さむなるらし",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "山のはに更ていてたる月影のはつかにたにもいかてしらせん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "長月のつゝきの原の草の葉に〓しはいたくをける露哉",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "さりともとわかあらましに賴まれて行末しらぬみ社おしけれ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "いか計身のあやまちの積るらん哀我よのありのすまひに",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "天津空なとて神代のはしめより春はかりたつ霞なるらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "梅の花それとみえねと折袖のぬるゝや雪のしるし成らん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "淚にはさらてもぬるゝ我袖をしらてや秋の露はをくらむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "もしほやく煙は空に消ぬれと春とや月の猶かすむらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "忘らるゝうき名を外にしられしと人まち顔にくらすころ哉",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "村雨のやかてはれぬるを山田のまさらぬ水に早苗とるなり",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "つらからはいかにせんとか行末の心もしらす思ひそむらむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "木の葉こそ風のさそへはもろからめなとか涙の秋は落らん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "うかりける人の言の葉なけゝとてなと僞のある世成らむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "何とかは人にも今はかたるへきみのうき程はよそにみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "みる人のなきか數そふ春每に花もあたなる世をやしるらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "おきつかせうきねの袖を吹かへし浦つたへ行秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "ほたる飛きしの木陰や天河ほしのはやしの名にやたつらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "木の葉散かたのゝ原に秋くれて舟なかしたる天の川浪",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "冬河の淵ともならてよとめるはいかにせをせく氷なるらむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "みよしのゝ瀧津はや瀨に澄月や冬も氷らぬ氷成らん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "なからへてあるもつらきか爲なれはうきや我みの命成らむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "こぬ人をいくよの月にうらむらん我影にのみ枕ならへて",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "そむくへき浮世の中のとはりをしりてまとふは心なりけり",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "もみち葉の色なる袖のみなと社心の秋のとまり成らめ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "雲よりもよそに成行かつらきの高まの櫻あらし吹らし",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "なへて世の思ふか中の習には別ありとやはるも行らん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "秋の野の尾花にましる鹿のねは色にや妻を戀渡るらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "いつくより哀をかせのさそひきて荻の上葉の音と成らむ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "手にならすかひこそなけれ梓弓ひけは中のみ遠さかりつゝ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "あはてこそ戀をいのれと賴しか今はたなにか命なるへき",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "きぬ〓〓の袂に分し月影は誰淚にかうつりはつらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "すてやらぬ心からにやいてさらん浮世の關はもる人もなし",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "里遠み鹽やく浦はみえわかて煙りにかへる沖津しらなみ",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "うきも猶さこそはあれと〓とはりを世に慰めてみそふりにける",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "人にのみつらさはみえて吹風の心にかなふ山さくらかな",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "たえ〓〓にたなひく雲はあらはれてまよひもはてぬ山櫻かな",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "冬寒み忍ふの山の谷水は音にもたてすさそ氷るらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "かへりみる程て雲井の大江山いくのゝ道や末になりぬる",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "みる夢の覺てもさめす悲しきはいかにねしよの名殘なるらん",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "あふ事のたえまかちなるつらさかと思ひし程の契りたになし",
   "kana": "",
   "speaker": "",
   "page": 522,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "いとせめて待にたへたる我みそとしりてや人の難面かるらん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "いかにせむ戀路の末に關すへてゆけとも遠き相坂のやま",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "ちかひてし命にかへて忘るゝはうき我からにみをやすつらむ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "をのかねにつらき別のありとたに思ひもしらて鳥や鳴らん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "なかき日の杜のしめなれはくりかへしあかすかたらふ郭公哉",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "あはれをはいつくにそふる影ならんつらさ霞める春のよの月",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "しほれつる夜のまの露のひるまたに草葉やすめぬ秋の村雨",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "さほ姫の我袖ひとつ大空に有とや春の霞たつらん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "月ならて夜川にさせるかゝり火も同しかつらの光成けり",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "月たにもかすみかへたる春の夜に山のはてらす花の色かな",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "かた岡の杜の木葉も色つきぬわさたのをしね今やからまし",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "あらしこす外山の嶺のときは木に雪けしくれてかゝる村雲",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "おもふ事げになくさむる月ならは苔の袂は秋やほさまし",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "さゝ波や遠さかり行にほの海は氷そ浦のしほひ成ける",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "さりとても有はてぬよのはかなきになとしぬ計戀しかるらん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "忘れねよ夢そといひしかね事をなとそのまゝに賴まさりけん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "衣〓〓にならはいかにと思ふより夜ふかく落る我淚かな",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "たらちねのおやのみるよと祈りこし我かれ〓をを神やうけけん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "いかにせん死なはともにと思ふみのおなし限の哀ならすは",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "あら磯にこけむす計年へたる岩ほはいつの眞砂なるらん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "今まてもあるは思ひの外なれはみを歎くへき〓とはりもなし",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "みしめひく三輪の杉村ふりにけりこれや神代のしるし成らん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "207",
   "text": "をこたらぬみにこそおもへ住吉の神はまことに道まもりけり",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
